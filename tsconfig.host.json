{
  // Host aggregate (one of the two check units; see tsconfig.json). packages/client
  // type-checks in tsconfig.client.json: the two sides merge cordis Context under
  // the same keys, one program cannot see both.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false
  },
  "include": [
    "apps/cli/tests/**/*.ts",
    "packages/experimental/cua-macos/native/generate-protocol.ts",
    "website/.vitepress/**/*.ts"
  ],
  // Under packages/client and benchmarks, a test file names the face it covers:
  // `*.client.*` belongs to the Client aggregate, `*.host.spec.ts` to this one. The two
  // suffixes are mutually exclusive, so each aggregate excludes the other's
  // and the package test glob above needs no per-file entry.
  "exclude": [
    "apps/desktop/tests/keyboard.spec.ts",
    "packages/client/*/src/**",
    "packages/client/tsdown.client.ts",
    "scripts/client-bundle-css.spec.ts",
    "packages/typert/generator/tests/fixtures/**",
    "scripts/client-bundle-purity.spec.ts"
  ],
  "references": [
    { "path": "./apps/kernel" },
    { "path": "./packages/client/locale/tsconfig.host.json" },
    { "path": "./packages/client/ui-theme/tsconfig.host.json" },
    { "path": "./packages/client/ui-settings/tsconfig.host.json" },
    { "path": "./packages/client/ui-shell" },
    { "path": "./packages/api/shell-remotes" },
    { "path": "./packages/boot/config-editor" },
    { "path": "./packages/client/connection/tsconfig.host.json" },
    { "path": "./vendor/cosmokit" },
    { "path": "./vendor/schemastery" },
    { "path": "./vendor/cordis" },
    { "path": "./vendor/loader" },
    { "path": "./vendor/include" },
    { "path": "./vendor/group" },
    { "path": "./vendor/timer" },
    { "path": "./vendor/hmr" },
    { "path": "./packages/boot/hmr" },
    { "path": "./vendor/logger-console" },
    { "path": "./packages/util/brand" },
    { "path": "./packages/util/package-manifest" },
    { "path": "./packages/util/plugin-detail" },
    { "path": "./packages/util/http-proxy" },
    { "path": "./packages/util/launch-environment" },
    { "path": "./packages/util/native-command" },
