{
  "name": "@deepseek-ai/dsh-api-shell-remotes",
  "description": "Settings-only Client Remote assembly for the standalone shell",
  "version": "0.2.2-alpha.3",
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/deepseek-ai/deepseek-harness.git", "directory": "packages/api/shell-remotes" },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./types": { "types": "./lib/types/types.d.ts", "default": "./lib/types/types.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.js", "lib/types/**/*.d.ts", "locale/*.json"],
  "license": "MIT",
  "dsh": { "client": { "platform": "web", "immediately": true, "inject": ["@deepseek-ai/dsh-api-gateway"] } },
  "scripts": { "bundle": "tsdown", "watch": "tsdown --watch" },
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:~" },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/dsh-api-gateway": "workspace:*",
    "@deepseek-ai/dsh-api-settings-controller": "workspace:*",
    "@deepseek-ai/dsh-settings": "workspace:*",
    "@deepseek-ai/dsh-typert-protocol": "workspace:*"
  }
}
